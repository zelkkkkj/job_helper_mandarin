{
  "manifest_version": 3,
  "name": "Internship Helper · 实习申请助手",
  "description": "筛选公开岗位、读取当前岗位详情、辅助填写基本资料，并记录申请进度。提交由你完成。",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://boards-api.greenhouse.io/*", "https://api.lever.co/*", "https://api.eu.lever.co/*"],
  "action": {"default_popup": "popup.html", "default_title": "实习申请助手"},
  "options_page": "dashboard.html"
}
